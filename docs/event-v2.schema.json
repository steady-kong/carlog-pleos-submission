{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlog.local/schemas/event-2.json",
  "title": "Carlog Event exchange v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "vehicleId",
    "occurredAt",
    "category",
    "source",
    "status",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "vehicleId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "category": {
      "enum": [
        "vehicle_issue",
        "road_condition",
        "unusual_driving",
        "location_note",
        "general"
      ]
    },
    "memo": {
      "type": "string"
    },
    "source": {
      "enum": [
        "MOCK",
        "VEHICLE"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "interrupted"
      ]
    },
    "samples": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "name",
          "value",
          "unit",
          "timestampKind"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "maxLength": 64
          },
          "timestampKind": {
            "enum": [
              "MEASURED",
              "RECEIVED",
              null
            ]
          }
        }
      }
    }
  }
}
