{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlog.local/schemas/event-1.json",
  "title": "Carlog Event exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "vehicleId", "occurredAt", "category", "source", "status", "samples"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "vehicleId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "category": { "enum": ["vehicle_issue", "road_condition", "unusual_driving", "location_note", "general"] },
    "memo": { "type": "string" },
    "source": { "enum": ["MOCK", "VEHICLE"] },
    "status": { "enum": ["collecting", "complete", "interrupted"] },
    "samples": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["timestamp", "name", "value", "unit"], "properties": { "timestamp": { "type": "string", "format": "date-time" }, "name": { "type": "string" }, "value": { "type": "number" }, "unit": { "type": "string" } } } }
  }
}
