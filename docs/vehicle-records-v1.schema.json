{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlog.local/schemas/vehicle-records-1.json",
  "title": "Carlog vehicle management exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "vehicle",
    "records",
    "schedules"
  ],
  "properties": {
    "format": {
      "const": "carlog-vehicle-records"
    },
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "initialOdometerKm",
        "maker",
        "model",
        "year",
        "fuelType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "initialOdometerKm": {
          "type": "number",
          "minimum": 0
        },
        "maker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1886,
              "maximum": 2100
            },
            {
              "type": "null"
            }
          ]
        },
        "fuelType": {
          "enum": [
            "gasoline",
            "diesel",
            "lpg",
            "hybrid",
            "ev",
            null
          ]
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "occurredAt",
          "odometerKm",
          "amountLiters",
          "costKrw",
          "label",
          "fullTank",
          "category",
          "expenseCategoryCode",
          "engineHours",
          "engineHoursMode",
          "updatedAt",
          "relatedEventId",
          "repairOutcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "type": {
            "enum": [
              "fuel",
              "expense",
              "maintenance",
              "odometer"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "odometerKm": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "amountLiters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "costKrw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "fullTank": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expenseCategoryCode": {
            "enum": [
              "insurance",
              "tax",
              "parking",
              "toll",
              "wash",
              "fine",
              "accessory",
              "etc",
              null
            ]
          },
          "engineHours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "engineHoursMode": {
            "enum": [
              "cumulative",
              "incremental",
              null
            ]
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "relatedEventId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "repairOutcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "fuel"
                }
              }
            },
            "then": {
              "properties": {
                "amountLiters": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "fullTank": {
                  "type": "boolean"
                },
                "odometerKm": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "else": {
              "properties": {
                "amountLiters": {
                  "type": "null"
                },
                "fullTank": {
                  "type": "null"
                },
                "engineHours": {
                  "type": "null"
                },
                "engineHoursMode": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "odometer",
                    "maintenance"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "odometerKm": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "odometer"
                }
              }
            },
            "then": {
              "properties": {
                "costKrw": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "maintenance"
                }
              }
            },
            "else": {
              "properties": {
                "relatedEventId": {
                  "type": "null"
                },
                "repairOutcome": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "expense"
                }
              }
            },
            "else": {
              "properties": {
                "expenseCategoryCode": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "engineHours": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "engineHoursMode": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "lastOdometerKm",
          "intervalKm",
          "intervalMonths",
          "lastDoneAt",
          "intervalEngineHours",
          "category",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "label": {
            "type": "string"
          },
          "lastOdometerKm": {
            "type": "number"
          },
          "intervalKm": {
            "type": "number"
          },
          "intervalMonths": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "lastDoneAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "intervalEngineHours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
